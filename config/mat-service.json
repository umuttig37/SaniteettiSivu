  "faq": [
    {
      "question": "Mitä Lindström-vaihtomattopalvelu maksaa?",
      "answer": "Lindström-vaihtomattopalvelun hinnat alkavat 1,99 eurosta per matto viikossa + alv. Hinta riippuu maton koosta, väristä, vaihtovälistä ja määrästä."
    },
    {
      "question": "Mitä mattovuokraus tarkoittaa?",
      "answer": "Mattovuokrauksessa yritys käyttää mattoja palveluna niiden ostamisen sijaan. Matot vaihdetaan puhtaisiin sovitun vaihtovälin mukaisesti."
    },
    {
      "question": "Kuinka usein vaihtomatot voidaan vaihtaa?",
      "answer": "Palvelussa voidaan valita mattojen vaihto kerran kuukaudessa, kahdesti kuukaudessa tai viikoittain saatavilla olevan palveluvaihtoehdon mukaan."
    },
    {
      "question": "Minkä kokoisia vaihtomattoja on saatavana?",
      "answer": "Normaalimatoissa saatavana on useita kokoja 85 × 150 cm matosta aina 150 × 250 cm kokoon asti. Saatavilla olevat värit riippuvat valitusta koosta."
    },
    {
      "question": "Sopiiko vaihtomatto yrityksen sisäänkäyntiin?",
      "answer": "Kyllä. Lindström-vaihtomatot sopivat esimerkiksi yritysten sisäänkäynteihin ja kulkuväylille, joissa halutaan vähentää lian ja kosteuden kulkeutumista sisätiloihin."
    },
    {
      "question": "Voinko kilpailuttaa nykyisen mattopalveluni?",
      "answer": "Kyllä. Voit lähettää Suomen Paperitukulle nykyisen Lindström-laskusi tai tarjouksesi. Käymme läpi matot, määrät ja vaihtovälit ja teemme vertailutarjouksen."
    },
    {
      "question": "Voiko yritys tilata useita vaihtomattoja?",
      "answer": "Kyllä. Hintalaskurissa voit valita mattojen määrän. Suuremmista kokonaisuuksista voit myös pyytää erillisen tarjouksen."
    }
  ],
