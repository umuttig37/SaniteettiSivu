# Copy the exact SMTP host shown in the Zoho account's Server Configuration Details.
# Paid custom-domain Zoho Mail accounts commonly use smtppro.zoho.com.
# SMTP_USERNAME / MAIL_USER / GMAIL_USER are also supported aliases.
SMTP_USER=info@suomenpaperitukku.fi
# Use a Zoho app-specific password when multi-factor authentication is enabled.
# SMTP_PASSWORD / MAIL_PASS / GMAIL_APP_PASSWORD are also supported aliases.
SMTP_PASS=your_zoho_app_password
SMTP_HOST=smtppro.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_NAME=suomenpaperitukku.fi
MAIL_FROM="Suomen Paperitukku <info@suomenpaperitukku.fi>"
MAIL_TO=umut.uygur30@gmail.com
# ADMIN_USERNAME and ADMIN_EMAIL are also supported aliases.
ADMIN_USER=your_admin_user
# ADMIN_PASSWORD is also supported as an alias.
ADMIN_PASS=your_admin_password
API_PORT=8787
SITE_URL=https://suomenpaperitukku.fi
# Local Paytrail testing needs a public HTTPS URL, e.g. Cloudflare Tunnel or ngrok.
PAYTRAIL_SITE_URL=
# PAYTRAIL_MERCHANT_ID and CHECKOUT_ACCOUNT are also supported aliases.
PAYTRAIL_ACCOUNT_ID=your_paytrail_merchant_id
# PAYTRAIL_SECRET_KEY, PAYTRAIL_API_SECRET and CHECKOUT_SECRET are also supported aliases.
PAYTRAIL_SECRET=your_paytrail_secret
PAYTRAIL_ALGORITHM=sha256
